{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Euryalus-Kay/SubTeams/blob/main/templates/team-spec.schema.json",
  "title": "TEAM_SPEC",
  "description": "Specification for a generated multi-agent team. Produced by team-architect, consumed by the meta-orchestrator's generator step and validated by team-qa-reviewer.",
  "type": "object",
  "required": [
    "team_name",
    "generated_at",
    "project_summary",
    "pattern",
    "pattern_rationale",
    "communication_topology",
    "agents",
    "quality_gates",
    "shared_context"
  ],
  "additionalProperties": false,
  "properties": {
    "team_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}$",
      "description": "kebab-case, 3-40 chars, must start with a letter"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "pattern": {
      "type": "string",
      "enum": [
        "orchestrator-worker",
        "parallel-sectioning",
        "sequential-pipeline",
        "evaluator-optimizer",
        "router",
        "hybrid"
      ]
    },
    "pattern_rationale": {
      "type": "string",
      "minLength": 50,
      "description": "One-paragraph justification citing the research report"
    },
    "communication_topology": {
      "type": "string",
      "enum": ["subagent", "agent-team"],
      "description": "subagent = hub-and-spoke (workers return strings to lead); agent-team = peer mailbox + shared task list"
    },
    "agents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/agent" }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/quality_gate" }
    },
    "shared_context": {
      "type": "object",
      "required": ["claude_md_additions", "scratch_dir"],
      "additionalProperties": false,
      "properties": {
        "claude_md_additions": {
          "type": "string",
          "maxLength": 3000,
          "description": "Text to append to project CLAUDE.md. Inherited by every teammate. Keep terse — every byte costs context on every session."
        },
        "scratch_dir": {
          "type": "string",
          "pattern": "^\\.[a-z0-9][a-z0-9._/-]*[a-z0-9]$",
          "description": "Where teammates write intermediate artifacts so they don't pipe large outputs through the lead. Must be a hidden directory (start with .). Common patterns: .claude/.team-builder-scratch, .research-scratch, .scratch."
        }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": [
        "name",
        "role",
        "template",
        "model",
        "tools",
        "responsibilities",
        "trigger_phrase",
        "stop_criteria",
        "max_turns"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,40}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "orchestrator",
            "researcher",
            "implementer",
            "reviewer",
            "verifier",
            "specialist"
          ]
        },
        "template": {
          "type": "string",
          "enum": [
            "orchestrator",
            "researcher",
            "implementer",
            "reviewer",
            "verifier",
            "specialist"
          ]
        },
        "model": {
          "type": "string",
          "enum": ["opus", "sonnet", "haiku", "inherit"]
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "responsibilities": {
          "type": "string",
          "minLength": 30
        },
        "trigger_phrase": {
          "type": "string",
          "minLength": 10,
          "description": "Goes verbatim into the agent's `description` frontmatter. This is what Claude Code uses to route work."
        },
        "stop_criteria": {
          "type": "string",
          "minLength": 10,
          "description": "Explicit, checkable success condition. 'When done' is not allowed."
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "owns_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns this agent is allowed to write/edit. Must not overlap with other agents' globs."
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other agent names this agent's output depends on (for sequential ordering)."
        },
        "communicates_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent names this agent is expected to message (Agent Team mode only)."
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional skills to load into this agent's context."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "orchestrator" } } },
          "then": {
            "properties": {
              "tools": {
                "contains": { "const": "Agent" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": { "enum": ["reviewer", "verifier"] }
            }
          },
          "then": {
            "properties": {
              "tools": {
                "not": {
                  "anyOf": [
                    { "contains": { "const": "Write" } },
                    { "contains": { "const": "Edit" } }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "quality_gate": {
      "type": "object",
      "required": ["type", "trigger"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["review-loop", "hook", "test-command", "judge"]
        },
        "trigger": {
          "type": "string",
          "description": "When the gate fires. e.g. 'after every implementer task completion'"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "For review-loop / judge gates only. Cap on revision cycles."
        }
      }
    }
  }
}
